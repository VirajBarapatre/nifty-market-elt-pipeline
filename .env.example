# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
# Never put a real key or secret in this file.

# Google Cloud project that holds the BigQuery datasets
GCP_PROJECT_ID=nifty-pipeline-viraj

# Where BigQuery stores the datasets (Mumbai). Must be the same for every dataset.
BQ_LOCATION=asia-south1

# Dataset (BigQuery's name for a schema) that receives untouched yfinance data
BQ_RAW_DATASET=raw

# Dataset that dbt builds staging and marts models into
BQ_DBT_DATASET=analytics

# Path to the service account key file. Keep it OUTSIDE this repo folder.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<your-user>/.gcp/nifty-pipeline-sa.json

# Airflow (Docker Compose) runs containers as this user id
AIRFLOW_UID=50000
